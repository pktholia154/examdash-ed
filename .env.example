# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Razorpay Payment Gateway Credentials
# Configure these as Cloud Run Runtime Environment Variables / Secrets in production.
# Server accepts NEXT_PUBLIC_RAZORPAY_KEY_ID or RAZORPAY_KEY_ID for the public Key ID.
NEXT_PUBLIC_RAZORPAY_KEY_ID="MY_RAZORPAY_KEY_ID"
RAZORPAY_KEY_SECRET="MY_RAZORPAY_KEY_SECRET"
RAZORPAY_WEBHOOK_SECRET="MY_RAZORPAY_WEBHOOK_SECRET"

# SEO & Crawl Architecture Configuration
# Production canonical origin (no trailing slash) and bare hostname (no protocol)
CANONICAL_APP_URL="https://exam-dash.com"
CANONICAL_HOST="exam-dash.com"
ENFORCE_CANONICAL_HOST="true"

# IndexNow verification key (8-128 hex/alphanumeric characters)
INDEXNOW_KEY="MY_INDEXNOW_KEY"

# Server-only secret protecting POST /api/seo/revalidate
SEO_REVALIDATE_SECRET="MY_SEO_REVALIDATE_SECRET"

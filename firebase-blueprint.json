{
  "entities": {
    "Book": {
      "title": "Book",
      "description": "Published or draft digital book / question bank document in the books collection.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "isPublished": { "type": "boolean" },
        "isDeleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "publishAt": { "type": "string", "format": "date-time" },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "urlSlug": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[a-z0-9\\-]+$" },
        "seoDescription": { "type": "string", "maxLength": 500 },
        "fullDescription": { "type": "string", "maxLength": 10000 },
        "type": { "type": "string", "maxLength": 80 },
        "language": { "type": "string", "maxLength": 60 },
        "publisher": { "type": "string", "maxLength": 120 },
        "authorName": { "type": "string", "maxLength": 120 },
        "tags": { "type": "array" },
        "currency": { "type": "string", "minLength": 3, "maxLength": 8 },
        "listPrice": { "type": "number" },
        "buyPrice": { "type": "number" },
        "sampleMarkdownUrl": { "type": "string", "maxLength": 1000 },
        "samplePdfUrl": { "type": "string", "maxLength": 1000 },
        "fullMarkdownStoragePath": { "type": "string", "maxLength": 500 },
        "fullPdfStoragePath": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "isPublished", "isDeleted", "title", "urlSlug", "currency", "listPrice", "buyPrice"]
    },
    "ExamPackDocument": {
      "title": "ExamPackDocument",
      "description": "Online exam pack / mock test series document in the ExamPackDocument collection.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "isPublished": { "type": "boolean" },
        "isDeleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "publishAt": { "type": "string", "format": "date-time" },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "urlSlug": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[a-z0-9\\-]+$" },
        "seoDescription": { "type": "string", "maxLength": 500 },
        "fullDescription": { "type": "string", "maxLength": 10000 },
        "type": { "type": "string", "maxLength": 80 },
        "language": { "type": "string", "maxLength": 60 },
        "publisher": { "type": "string", "maxLength": 120 },
        "authorName": { "type": "string", "maxLength": 120 },
        "tags": { "type": "array" },
        "currency": { "type": "string", "minLength": 3, "maxLength": 8 },
        "listPrice": { "type": "number" },
        "buyPrice": { "type": "number" },
        "totalMocktest": { "type": "number" },
        "MocktestTitles": { "type": "array" },
        "fullJsonStoragePath": { "type": "string", "maxLength": 500 },
        "sampleJsonStoragePath": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "isPublished", "isDeleted", "title", "urlSlug", "currency", "listPrice", "buyPrice", "totalMocktest"]
    },
    "UserProfilePrivate": {
      "title": "UserProfilePrivate",
      "description": "Private user account record storing display profile and study analytics summary.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "photoURL": { "type": "string", "maxLength": 1000 },
        "testsAttempted": { "type": "number" },
        "booksOwned": { "type": "number" },
        "examsOwned": { "type": "number" },
        "averageAccuracy": { "type": "number" },
        "studyStreakDays": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "testsAttempted", "booksOwned", "examsOwned", "averageAccuracy", "studyStreakDays", "createdAt", "updatedAt"]
    },
    "UserCartItem": {
      "title": "UserCartItem",
      "description": "User-scoped shopping cart item referencing a catalog book or exam pack.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "itemId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "contentType": { "type": "string", "enum": ["books", "exams", "quizbooks"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "urlSlug": { "type": "string", "minLength": 1, "maxLength": 240 },
        "currency": { "type": "string", "minLength": 3, "maxLength": 8 },
        "buyPrice": { "type": "number" },
        "listPrice": { "type": "number" },
        "quantity": { "type": "number" },
        "addedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "uid", "itemId", "contentType", "title", "urlSlug", "currency", "buyPrice", "listPrice", "quantity", "addedAt", "updatedAt"]
    },
    "UserPurchase": {
      "title": "UserPurchase",
      "description": "Verified Razorpay purchase entitlement owned by a signed-in user.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "itemId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "contentType": { "type": "string", "enum": ["books", "exams", "quizbooks"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "urlSlug": { "type": "string", "minLength": 1, "maxLength": 240 },
        "currency": { "type": "string", "minLength": 3, "maxLength": 8 },
        "amountPaid": { "type": "number" },
        "razorpayOrderId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "razorpayPaymentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "entitlementProof": { "type": "string", "minLength": 16, "maxLength": 512 },
        "status": { "type": "string", "enum": ["completed"] },
        "purchasedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "uid", "itemId", "contentType", "title", "urlSlug", "currency", "amountPaid", "razorpayOrderId", "razorpayPaymentId", "entitlementProof", "status", "purchasedAt"]
    },
    "ReadingProgress": {
      "title": "ReadingProgress",
      "description": "Synced PDF and Markdown reading resume state for a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "format": { "type": "string", "enum": ["pdf", "markdown"] },
        "mode": { "type": "string", "enum": ["sample", "full"] },
        "pageIndex": { "type": "number" },
        "totalPages": { "type": "number" },
        "offsetRatio": { "type": "number" },
        "blockIndex": { "type": "number" },
        "zoomScale": { "type": "number" },
        "progressPercent": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "uid", "bookId", "format", "mode", "pageIndex", "totalPages", "offsetRatio", "blockIndex", "zoomScale", "progressPercent", "updatedAt"]
    }
  },
  "firestore": {
    "/books/{bookId}": {
      "schema": { "$ref": "#/entities/Book" },
      "description": "Public catalog of published books and question banks; writes restricted to admins."
    },
    "/ExamPackDocument/{examId}": {
      "schema": { "$ref": "#/entities/ExamPackDocument" },
      "description": "Public catalog of published online exam packs and mock test series; writes restricted to admins."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfilePrivate" },
      "description": "Private user account and study analytics summary accessible strictly to the owner or admin."
    },
    "/users/{userId}/cart/{cartItemId}": {
      "schema": { "$ref": "#/entities/UserCartItem" },
      "description": "User-scoped shopping cart items synchronized across devices when signed in."
    },
    "/users/{userId}/purchases/{purchaseId}": {
      "schema": { "$ref": "#/entities/UserPurchase" },
      "description": "Verified Razorpay purchase entitlements owned by the user."
    },
    "/users/{userId}/readingProgress/{progressId}": {
      "schema": { "$ref": "#/entities/ReadingProgress" },
      "description": "Cross-device reading progress state for PDF and Markdown readers."
    }
  }
}

// 5. UNIFIED ATTEMPT CHECKER, OPTIONS & NAT INPUT
// ============================================================================
export function isQuestionAttempted(question: { type: string }, rawAnswer: any): boolean {
  if (rawAnswer === null || rawAnswer === undefined) return false;
  if (question.type === "MSQ") {
    return Array.isArray(rawAnswer) && rawAnswer.some((v) => String(v).trim() !== "");
  }
  const str = String(rawAnswer).trim();
  if (str === "" || (question.type === "NAT" && (str === "-" || str === "." || str === "-."))) {
    return false;
  }
  return question.type === "NAT" ? Number.isFinite(Number(str)) : true;
}

export function QuestionResponseBlock({
  question,
  userAnswer,
  onChange,
  isAttemptCapReached = false,
  showVirtualKeypad = true,
  renderLatex = defaultRenderLatex,
}: {
  question: any;
  userAnswer: any;
  onChange: (val: any) => void;
  isAttemptCapReached?: boolean;
  showVirtualKeypad?: boolean;
  renderLatex?: (txt: any) => React.ReactNode;
}) {
  const hasExistingAnswer =
    isQuestionAttempted(question, userAnswer) ||
    (userAnswer !== null && userAnswer !== undefined && String(userAnswer) !== "" && !Array.isArray(userAnswer));

  const isLockedByCap = isAttemptCapReached && !hasExistingAnswer;

  if (question.type === "NAT") {
    const valStr = userAnswer !== null && userAnswer !== undefined ? String(userAnswer) : "";

    const handleNumericInput = (next: string) => {
      if (isLockedByCap) return;
      if (next === "" || /^-?\d*\.?\d*$/.test(next)) {
        onChange(next);
      }
    };

    const handleKeyPress = (key: string) => {
      if (isLockedByCap) return;
      if (key === "CLEAR") return onChange("");
      if (key === "BACKSPACE") return onChange(valStr.slice(0, -1));
      if (key === "-") return onChange(valStr.startsWith("-") ? valStr.slice(1) : "-" + valStr);
      if (key === "." && valStr.includes(".")) return;
      handleNumericInput(valStr + key);
    };

    return (
      <div className="mt-4 space-y-3">
        {isLockedByCap && (
          <div className="rounded-lg border border-amber-300 bg-amber-50 p-2.5 text-xs font-medium text-amber-800">
            Maximum attempt limit reached for this section. Clear an existing response in this section first.
          </div>
        )}
        <div>
          <label className="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-500">
            Enter Numerical Answer:
          </label>
          <input
            type="text"
            inputMode="decimal"
            disabled={isLockedByCap}
            value={valStr}
            onChange={(e) => handleNumericInput(e.target.value)}
            placeholder="Type numerical answer"
            className="w-64 rounded-lg border border-slate-300 px-3 py-2 text-base font-semibold text-slate-900 focus:border-blue-600 focus:outline-none disabled:bg-slate-100"
          />
        </div>

        {showVirtualKeypad && !isLockedByCap && (
          <div className="inline-grid grid-cols-4 gap-1.5 rounded-xl border border-slate-200 bg-slate-50 p-2.5">
            {["7", "8", "9", "BACKSPACE", "4", "5", "6", "-", "1", "2", "3", ".", "0", "CLEAR"].map((k) => (
              <button
                key={k}
                type="button"
                onClick={() => handleKeyPress(k)}
                className={`rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-bold text-slate-700 shadow-sm hover:bg-slate-100 ${
                  k === "CLEAR" || k === "BACKSPACE" ? "col-span-2 text-red-600" : ""
                }`}
              >
                {k === "BACKSPACE" ? "⌫" : k}
              </button>
            ))}
          </div>
        )}
      </div>
    );
  }

  const isMSQ = question.type === "MSQ";
  const selectedArray: string[] = Array.isArray(userAnswer) ? userAnswer : [];
  const optionsList = Array.isArray(question.options) ? question.options : [];

  return (
    <div className="mt-4 space-y-2.5">
      {isLockedByCap && (
        <div className="rounded-lg border border-amber-300 bg-amber-50 p-2.5 text-xs font-medium text-amber-800">
          Maximum attempt limit reached for this section. Clear an existing response in this section first.
        </div>
      )}

      {optionsList.map((opt: any) => {
        const isSelected = isMSQ ? selectedArray.includes(opt.id) : userAnswer === opt.id;

        const handleSelect = () => {
          if (isLockedByCap) return;
          if (!isMSQ) {
            onChange(isSelected ? null : opt.id);
          } else {
            const next = isSelected
              ? selectedArray.filter((id) => id !== opt.id)
              : Array.from(new Set([...selectedArray, opt.id])).sort();
            onChange(next);
          }
        };

        return (
          <button
            key={opt.id}
            type="button"
            disabled={isLockedByCap}
            onClick={handleSelect}
            className={`flex w-full items-start gap-3 rounded-xl border p-3.5 text-left transition ${
              isSelected
                ? "border-blue-600 bg-blue-50/70 ring-1 ring-blue-600"
                : "border-slate-200 bg-white hover:bg-slate-50 disabled:opacity-60"
            }`}
          >
            <span
              className={`mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-md border text-xs font-bold ${
                isSelected ? "border-blue-600 bg-blue-600 text-white" : "border-slate-300 text-slate-600"
              }`}
            >
              {opt.id}
            </span>
            <div className="flex-1 space-y-2">
              {opt.text && <div className="text-sm text-slate-800">{renderLatex(opt.text)}</div>}
              {opt.visual && <SingleVisualCard visual={opt.visual} renderLatex={renderLatex} />}
            </div>
          </button>
        );
      })}
    </div>
  );
}

// ============================================================================
// 6. UNIVERSAL QUESTION & FULL-EXAM GRADING ENGINE
// ============================================================================
export function evaluateQuestion(
  question: {
    type: "MCQ" | "MSQ" | "NAT";
    marks: { correct: number; wrong: number; partial?: number };
    answer: string | string[] | [number, number];
  },
  userAnswer: any
): { status: "UNATTEMPTED" | "CORRECT" | "PARTIAL" | "WRONG"; marksAwarded: number } {
  const { type, marks, answer } = question;
  const correctMarks = Number(marks?.correct ?? 1);
  const wrongPenalty = -Math.abs(Number(marks?.wrong ?? 0));

  if (!isQuestionAttempted(question, userAnswer)) {
    return { status: "UNATTEMPTED", marksAwarded: 0 };
  }

  if (type === "MCQ") {
    const isCorrect = String(userAnswer).trim() === String(answer).trim();
    return {
      status: isCorrect ? "CORRECT" : "WRONG",
      marksAwarded: isCorrect ? correctMarks : wrongPenalty,
    };
  }

  if (type === "NAT") {
    const num = Number(String(userAnswer).trim());
    if (!Number.isFinite(num) || !Array.isArray(answer) || answer.length < 2) {
      return { status: "WRONG", marksAwarded: wrongPenalty };
    }
    const min = Math.min(Number(answer[0]), Number(answer[1]));
    const max = Math.max(Number(answer[0]), Number(answer[1]));
    const isCorrect = num >= min - 1e-6 && num <= max + 1e-6;
    return {
      status: isCorrect ? "CORRECT" : "WRONG",
      marksAwarded: isCorrect ? correctMarks : wrongPenalty,
    };
  }

  if (type === "MSQ") {
    const correctSet = new Set((Array.isArray(answer) ? answer : []).map((v) => String(v).trim()).filter(Boolean));
    const userSet = new Set((Array.isArray(userAnswer) ? userAnswer : []).map((v) => String(v).trim()).filter(Boolean));

    if (correctSet.size === 0 || userSet.size === 0) {
      return { status: "UNATTEMPTED", marksAwarded: 0 };
    }

    for (const opt of userSet) {
      if (!correctSet.has(opt)) {
        return { status: "WRONG", marksAwarded: wrongPenalty };
      }
    }

    if (userSet.size === correctSet.size) {
      return { status: "CORRECT", marksAwarded: correctMarks };
    }

    const partialRate = Number(marks?.partial ?? 0);
    if (partialRate > 0) {
      return {
        status: "PARTIAL",
        marksAwarded: Math.min(userSet.size * partialRate, correctMarks),
      };
    }

    return { status: "WRONG", marksAwarded: wrongPenalty };
  }

  return { status: "UNATTEMPTED", marksAwarded: 0 };
}

export function evaluateFullExam(
  exam: any,
  userResponses: Record<string, any>
) {
  let totalScore = 0;
  const sectionResults: Record<string, { score: number; attempted: number }> = {};
  const questionResults: Record<string, any> = {};

  for (const section of exam.sections || []) {
    let sectionScore = 0;
    let attemptedCount = 0;
    const maxAttempts = section.maxAttempts ? Number(section.maxAttempts) : null;

    for (const q of section.questions || []) {
      const rawAnswer = userResponses[q.id];
      const attempted = isQuestionAttempted(q, rawAnswer);

      if (attempted && maxAttempts !== null && attemptedCount >= maxAttempts) {
        questionResults[q.id] = { status: "UNATTEMPTED", marksAwarded: 0, ignoredByCap: true };
        continue;
      }

      if (attempted) attemptedCount++;

      const res = evaluateQuestion(q, rawAnswer);
      questionResults[q.id] = res;
      sectionScore += res.marksAwarded;
    }

    sectionResults[section.id] = {
      score: Number(sectionScore.toFixed(2)),
      attempted: attemptedCount,
    };
    totalScore += sectionScore;
  }

  return {
    totalScore: Number(totalScore.toFixed(2)),
    sectionResults,
    questionResults,
  };
}


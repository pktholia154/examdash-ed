"use client";

import React, { useEffect, useId, useRef, useState } from "react";
import {
  ResponsiveContainer, ComposedChart, Bar, Line, Scatter, PieChart, Pie, Cell,
  XAxis, YAxis, Tooltip, Legend, CartesianGrid, RadarChart, Radar,
  PolarGrid, PolarAngleAxis, PolarRadiusAxis
} from "recharts";
import katex from "katex";
import "katex/contrib/mhchem";

const COLORS = ["#2563eb", "#dc2626", "#16a34a", "#d97706", "#7c3aed", "#0891b2"];

// ============================================================================
// 1. SVG SANITIZER & DEFENSIVE LATEX + CHEMISTRY (\ce) + MARKDOWN RENDERER
// ============================================================================
function sanitizeSvg(raw: string): string {
  return String(raw || "")
    .replace(/<script[\s\S]*?>[\s\S]*?<\/script>/gi, "")
    .replace(/<foreignObject[\s\S]*?>[\s\S]*?<\/foreignObject>/gi, "")
    .replace(/\son[a-z]+\s*=\s*(?:"[^"]*"|'[^']*'|[^\s>]+)/gi, "")
    .replace(/(?:href|xlink:href)\s*=\s*(?:"\s*javascript:[^"]*"|'\s*javascript:[^']*')/gi, "");
}

export function defaultRenderLatex(input: any): React.ReactNode {
  if (input === null || input === undefined || input === "") return null;
  const text = String(input);

  const tokens = text.split(/(\$\$[\s\S]+?\$\$|\$(?!\s)(?:[^$\n]*?[^\s$\n])?\$)/g);

  return tokens.map((token, idx) => {
    if (token.startsWith("$$") && token.endsWith("$$") && token.length > 4) {
      const html = katex.renderToString(token.slice(2, -2), { displayMode: true, throwOnError: false });
      return <span key={idx} className="my-2 block overflow-x-auto" dangerouslySetInnerHTML={{ __html: html }} />;
    }
    if (token.startsWith("$") && token.endsWith("$") && token.length > 2) {
      const html = katex.renderToString(token.slice(1, -1), { displayMode: false, throwOnError: false });
      return <span key={idx} dangerouslySetInnerHTML={{ __html: html }} />;
    }

    return (
      <React.Fragment key={idx}>
        {token.split(/(\*\*[^*]+?\*\*)/g).map((part, bIdx) => {
          if (part.startsWith("**") && part.endsWith("**") && part.length > 4) {
            return <strong key={bIdx} className="font-semibold text-slate-900">{part.slice(2, -2)}</strong>;
          }
          return part.split("\n").map((line, lIdx, arr) => (
            <React.Fragment key={`${bIdx}-${lIdx}`}>
              {line}
              {lIdx < arr.length - 1 && <br />}
            </React.Fragment>
          ));
        })}
      </React.Fragment>
    );
  });
}

// ============================================================================
// 2. CLIENT DIAGRAM MOUNT FOR MERMAID.JS & SMILES MOLECULAR STRUCTURES
// ============================================================================
function DeclarativeDiagramMount({ type, data }: { type: "smiles" | "mermaid"; data: string }) {
  const safeId = useId().replace(/[^a-zA-Z0-9_-]/g, "_");
  const svgRef = useRef<SVGSVGElement | null>(null);
  const [mermaidSvg, setMermaidSvg] = useState<string>("");
  const [smilesError, setSmilesError] = useState<boolean>(false);

  useEffect(() => {
    let isMounted = true;

    if (type === "mermaid" && data) {
      import("mermaid").then(async (m) => {
        const mermaid = m.default;
        mermaid.initialize({ startOnLoad: false, theme: "neutral", securityLevel: "strict" });
        try {
          const { svg } = await mermaid.render(`mermaid_${safeId}`, String(data));
          if (isMounted) setMermaidSvg(sanitizeSvg(svg));
        } catch {
          if (isMounted) setMermaidSvg("");
        }
      });
    } else if (type === "smiles" && data && svgRef.current) {
      setSmilesError(false);
      svgRef.current.innerHTML = "";
      import("smiles-drawer")
        .then((SmilesDrawerModule: any) => {
          const SmilesDrawer = SmilesDrawerModule.default || SmilesDrawerModule;
          const drawer = new SmilesDrawer.SvgDrawer({ width: 280, height: 180 });
          SmilesDrawer.parse(
            String(data),
            (tree: any) => {
              if (isMounted && svgRef.current) {
                svgRef.current.innerHTML = "";
                drawer.draw(tree, svgRef.current, "light");
              }
            },
            () => {
              if (isMounted) setSmilesError(true);
            }
          );
        })
        .catch(() => {
          if (isMounted) setSmilesError(true);
        });
    }

    return () => {
      isMounted = false;
    };
  }, [type, data, safeId]);

  if (type === "mermaid") {
    return mermaidSvg ? (
      <div className="flex justify-center overflow-x-auto py-2" dangerouslySetInnerHTML={{ __html: mermaidSvg }} />
    ) : (
      <pre className="overflow-x-auto rounded bg-slate-50 p-2 text-xs text-slate-600">{data}</pre>
    );
  }

  if (smilesError) {
    return <code className="block rounded bg-slate-50 p-2 text-xs text-slate-700">{data}</code>;
  }

  return (
    <div className="flex justify-center overflow-x-auto py-2">
      <svg ref={svgRef} viewBox="0 0 280 180" className="max-h-48 w-auto" />
    </div>
  );
}


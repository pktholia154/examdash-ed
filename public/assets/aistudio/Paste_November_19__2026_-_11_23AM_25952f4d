// 3. SINGLE VISUAL CARD (Chart, Table, SVG, SMILES, Mermaid)
// ============================================================================
export function SingleVisualCard({
  visual,
  renderLatex = defaultRenderLatex,
}: {
  visual: any;
  renderLatex?: (txt: any) => React.ReactNode;
}) {
  if (!visual || typeof visual !== "object") return null;

  const isNumericScatterX =
    visual.type === "chart" &&
    visual.chartType === "scatter" &&
    typeof visual.data?.[0]?.[visual.xAxisKey] === "number";

  return (
    <div className="my-3 min-w-0 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      {visual.title && (
        <h4 className="mb-3 border-b pb-2 text-sm font-bold text-slate-800">
          {renderLatex(visual.title)}
        </h4>
      )}

      {visual.type === "chart" && Array.isArray(visual.data) && (
        <div className="h-72 w-full min-w-0">
          <ResponsiveContainer width="100%" height="100%">
            {visual.chartType === "pie" ? (
              <PieChart>
                <Pie
                  data={visual.data}
                  dataKey={visual.series?.[0]?.key || "value"}
                  nameKey={visual.xAxisKey || "name"}
                  cx="50%"
                  cy="50%"
                  outerRadius={90}
                  label
                >
                  {visual.data.map((_: any, i: number) => (
                    <Cell key={i} fill={COLORS[i % COLORS.length]} />
                  ))}
                </Pie>
                <Tooltip />
                <Legend />
              </PieChart>
            ) : visual.chartType === "radar" ? (
              <RadarChart data={visual.data}>
                <PolarGrid />
                <PolarAngleAxis dataKey={visual.xAxisKey} />
                <PolarRadiusAxis />
                {(visual.series || []).map((s: any, i: number) => (
                  <Radar
                    key={s.key || i}
                    name={s.label || s.key}
                    dataKey={s.key}
                    stroke={COLORS[i % COLORS.length]}
                    fill={COLORS[i % COLORS.length]}
                    fillOpacity={0.3}
                  />
                ))}
                <Legend />
                <Tooltip />
              </RadarChart>
            ) : (
              <ComposedChart data={visual.data}>
                <CartesianGrid strokeDasharray="3 3" />
                <XAxis dataKey={visual.xAxisKey} type={isNumericScatterX ? "number" : "category"} />
                <YAxis yAxisId="left" orientation="left" />
                {(visual.series || []).some((s: any) => s.yAxis === "right") && (
                  <YAxis yAxisId="right" orientation="right" />
                )}
                <Tooltip />
                <Legend />
                {(visual.series || []).map((s: any, i: number) => {
                  const yAxisId = s.yAxis || "left";
                  const color = COLORS[i % COLORS.length];
                  const isScatter = visual.chartType === "scatter" || s.type === "scatter";
                  const isLine = visual.chartType === "line" || s.type === "line";

                  if (isScatter) {
                    return <Scatter key={s.key || i} yAxisId={yAxisId} name={s.label} dataKey={s.key} fill={color} />;
                  }
                  if (isLine) {
                    return (
                      <Line
                        key={s.key || i}
                        yAxisId={yAxisId}
                        type="monotone"
                        dataKey={s.key}
                        name={s.label}
                        stroke={color}
                        strokeWidth={2.5}
                      />
                    );
                  }
                  return (
                    <Bar
                      key={s.key || i}
                      yAxisId={yAxisId}
                      dataKey={s.key}
                      name={s.label}
                      stackId={visual.chartType === "stacked_bar" ? "stack" : undefined}
                      fill={color}
                    />
                  );
                })}
              </ComposedChart>
            )}
          </ResponsiveContainer>
        </div>
      )}

      {visual.type === "table" && (
        <div className="overflow-x-auto">
          <table className="w-full border-collapse text-left text-sm">
            {Array.isArray(visual.headers) && visual.headers.length > 0 && (
              <thead>
                <tr className="bg-slate-100">
                  {visual.headers.map((h: any, i: number) => (
                    <th key={i} className="border border-slate-300 px-3 py-2 font-semibold text-slate-800">
                      {renderLatex(h)}
                    </th>
                  ))}
                </tr>
              </thead>
            )}
            <tbody>
              {(visual.rows || []).map((row: any[], rIdx: number) => (
                <tr key={rIdx} className="even:bg-slate-50">
                  {(row || []).map((cell: any, cIdx: number) => (
                    <td key={cIdx} className="border border-slate-300 px-3 py-2 text-slate-700">
                      {renderLatex(cell)}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {visual.type === "svg" && visual.data && (
        <div
          className="flex justify-center overflow-x-auto py-2 [&>svg]:max-h-72 [&>svg]:w-auto"
          dangerouslySetInnerHTML={{ __html: sanitizeSvg(visual.data) }}
        />
      )}

      {(visual.type === "smiles" || visual.type === "mermaid") && visual.data && (
        <DeclarativeDiagramMount type={visual.type} data={String(visual.data)} />
      )}

      {visual.note && (
        <div className="mt-3 rounded border-l-4 border-amber-400 bg-amber-50/70 px-3 py-2 text-xs text-slate-700">
          {renderLatex(visual.note)}
        </div>
      )}
    </div>
  );
}

// ============================================================================
// 4. MULTI-VISUAL CONTENT BLOCK (Supports Sequential or Interleaved {{v1}})
// ============================================================================
export function MultiVisualContentBlock({
  text,
  visuals = [],
  renderLatex = defaultRenderLatex,
}: {
  text?: string | null;
  visuals?: any[] | null;
  renderLatex?: (txt: any) => React.ReactNode;
}) {
  const safeVisuals = Array.isArray(visuals) ? visuals : [];
  const renderedIds = new Set<string>();
  const parts = text ? String(text).split(/(\{\{[a-zA-Z0-9_-]+\}\})/g) : [];

  return (
    <div className="space-y-3">
      {parts.map((part, idx) => {
        const match = part.match(/^\{\{([a-zA-Z0-9_-]+)\}\}$/);
        if (match) {
          const target = safeVisuals.find((v) => v && v.id === match[1]);
          if (target) {
            renderedIds.add(target.id);
            return <SingleVisualCard key={idx} visual={target} renderLatex={renderLatex} />;
          }
        }
        return part ? (
          <div key={idx} className="leading-relaxed text-slate-800">
            {renderLatex(part)}
          </div>
        ) : null;
      })}

      {safeVisuals
        .filter((v) => v && !renderedIds.has(v.id))
        .map((v, idx) => (
          <SingleVisualCard key={v.id || idx} visual={v} renderLatex={renderLatex} />
        ))}
    </div>
  );
}

